# Optional fallback. The preferred configuration is Admin > Pengaturan >
# Login Google Workspace, which stores the Client ID in the backend database.
VITE_GOOGLE_CLIENT_ID=isi-client-id-web-dari-google-cloud.apps.googleusercontent.com

# Use /api when frontend and backend share a domain. For separate Vercel
# projects, set this to the public backend URL ending in /api.
VITE_API_URL=/api
