PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bank_soal
DB_USER=root
DB_PASS=
# Set DB_SSL=true when the managed MySQL provider requires TLS.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=ganti_dengan_secret_yang_kuat
JWT_EXPIRES_IN=8h

UPLOAD_DIR=uploads

# Google Workspace SSO
GOOGLE_CLIENT_ID=isi-client-id-web-dari-google-cloud.apps.googleusercontent.com
GOOGLE_WORKSPACE_DOMAIN=kalamkudussentani.sch.id

# Gemini AI question generator
GEMINI_API_KEY=isi-api-key-gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_SETTINGS_ENCRYPTION_KEY=ganti_dengan_secret_acak_untuk_enkripsi_api_key
# Optional image model for automatic question illustrations.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
